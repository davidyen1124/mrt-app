{
  "name": "mrt-worker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "dev:assets": "npm --prefix ../frontend run build -- --watch",
    "dev:full": "npm-run-all --parallel dev:assets dev",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251011.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.43.0"
  }
}
